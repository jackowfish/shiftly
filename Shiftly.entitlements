<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks the camera outright without this, and the
	     rejection happens below TCC, so the request fails without ever
	     prompting or listing the app in Privacy & Security. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
